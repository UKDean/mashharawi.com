# Cloudflare Pages response headers.
#
# No script-src CSP yet. The header below only stops other sites framing
# these pages.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# Some pages load scripts without a ?v= query, so assets get one day fresh
# rather than a year immutable. site.css is linked as site.css?v=YYYYMMDD on
# every page (and in scripts/build_notes.py): bump that date whenever the
# stylesheet changes, or visitors keep the old one for up to a day.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/steelcalc/shots/*
  Cache-Control: public, max-age=604800

# Photos rarely change, so browsers keep them for 30 days and refresh them
# quietly in the background after that. If you replace a photo in place and
# need everyone to see it at once, save it under a new file name instead.
# The "! Cache-Control" line drops the one-day value from /assets/* above.
/assets/img/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/portrait*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/tools/rebarplan/screen-*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/ar/tools/rebarplan/screen-*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
